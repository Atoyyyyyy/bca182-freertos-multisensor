{
  "version": 1,
  "author": "Atoyyyyyy",
  "editor": "wokwi",

  "parts": [
    {
      "type": "board-stm32-bluepill",
      "id": "stm32",
      "top": 0,
      "left": 0,
      "attrs": {}
    },

    {
      "type": "wokwi-dht22",
      "id": "dht22",
      "top": -80,
      "left": 300,
      "attrs": {}
    },

    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr",
      "top": 180,
      "left": 300,
      "attrs": {}
    },

    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": -50,
      "left": 100,
      "rotate": 180,
      "attrs": {
        "i2cAddress": "0x3C"
      }
    },

    {
      "type": "wokwi-ky-040",
      "id": "encoder",
      "top": 300,
      "left": 450,
      "attrs": {}
    },

    {
      "type": "wokwi-pir-motion-sensor",
      "id": "pir",
      "top": 300,
      "left": 200,
      "attrs": {}
    },

    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": 180,
      "left": 500,
      "attrs": {}
    }
  ],

  "connections": [
    [
      "stm32:A9",
      "$serialMonitor:RX",
      "green",
      []
    ],
    [
      "stm32:A10",
      "$serialMonitor:TX",
      "green",
      []
    ],

    [
      "dht22:VCC",
      "stm32:3V3",
      "red",
      []
    ],
    [
      "dht22:GND",
      "stm32:GND",
      "black",
      []
    ],
    [
      "dht22:SDA",
      "stm32:A1",
      "blue",
      []
    ],

    [
      "ldr:VCC",
      "stm32:3V3",
      "red",
      []
    ],
    [
      "ldr:GND",
      "stm32:GND",
      "black",
      []
    ],
    [
      "ldr:AO",
      "stm32:A0",
      "yellow",
      []
    ],

    [
      "oled:VCC",
      "stm32:3V3",
      "red",
      []
    ],
    [
      "oled:GND",
      "stm32:GND",
      "black",
      []
    ],
    [
      "oled:SCL",
      "stm32:B6",
      "green",
      []
    ],
    [
      "oled:SDA",
      "stm32:B7",
      "blue",
      []
    ],

    [
      "encoder:VCC",
      "stm32:3V3",
      "red",
      []
    ],
    [
      "encoder:GND",
      "stm32:GND",
      "black",
      []
    ],
    [
      "encoder:CLK",
      "stm32:A4",
      "blue",
      []
    ],
    [
      "encoder:DT",
      "stm32:A5",
      "green",
      []
    ],

    [
      "pir:VCC",
      "stm32:3V3",
      "red",
      []
    ],
    [
      "pir:GND",
      "stm32:GND",
      "black",
      []
    ],
    [
      "pir:OUT",
      "stm32:A3",
      "green",
      []
    ],

    [
      "buzzer:1",
      "stm32:A2",
        "purple",
       []
],
[
       "buzzer:2",
       "stm32:GND",
       "black",
       []
]
  ],

  "serialMonitor": {
    "collapse": false,
    "convertEol": false,
    "display": "always",
