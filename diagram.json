{
  "version": 1,
  "author": "Atoyyyyyy",
  "editor": "wokwi",

  "parts": [
    {
      "type": "board-stm32-bluepill",
      "id": "stm32",
      "top": 0,
      "left": 0,
      "attrs": {}
    },

    {
      "type": "wokwi-dht22",
      "id": "dht22",
      "top": -80,
      "left": 300,
      "attrs": {}
    },

    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr",
      "top": 180,
      "left": 300,
      "attrs": {}
    },

    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": 40,
      "left": 400,
      "rotate": 180,
      "attrs": {
        "i2cAddress": "0x3C"
      }
    }
  ],

  "connections": [
    [
      "stm32:A9",
      "$serialMonitor:RX",
      "green",
      []
    ],
    [
      "stm32:A10",
      "$serialMonitor:TX",
      "green",
      []
    ],

    [
      "dht22:VCC",
      "stm32:3V3",
      "red",
      []
    ],
    [
      "dht22:GND",
      "stm32:GND",
      "black",
      []
    ],
    [
      "dht22:SDA",
      "stm32:B0",
      "blue",
      []
    ],

    [
      "ldr:VCC",
      "stm32:3V3",
      "red",
      []
    ],
    [
      "ldr:GND",
      "stm32:GND",
      "black",
      []
    ],
    [
      "ldr:AO",
      "stm32:A0",
      "yellow",
      []
    ],

    [
      "oled:VCC",
      "stm32:3V3",
      "red",
      []
    ],
    [
      "oled:GND",
      "stm32:GND",
      "black",
      []
    ],
    [
      "oled:SCL",
      "stm32:B6",
      "green",
      []
    ],
    [
      "oled:SDA",
      "stm32:B7",
      "blue",
      []
    ]
  ],

  "serialMonitor": {
    "collapse": false,
    "convertEol": false,
    "display": "always",
    "newline": "lf"
  },

  "dependencies": {}
}